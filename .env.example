# ==============================================================================
# .env.example — CAN IDS Data Pipeline (Temps 1)
# ==============================================================================


# ── SQL Server (local) ────────────────────────
SQL_SERVER_HOST=localhost
SQL_SERVER_DATABASE=CAN_IDS
SQL_SERVER_DRIVER={ODBC Driver 18 for SQL Server}

SQL_SERVER_USER=
SQL_SERVER_PASSWORD=

# ── Données ───────────────────────────────────
DATA_RAW_PATH=./data/raw

# ── Ingestion ─────────────────────────────────
INGEST_SPEED_FACTOR=100

